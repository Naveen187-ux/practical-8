#include <iostream>
#include <vector>
using namespace std;

void DFS(vector<vector<int>>& adj, vector<bool>& visited, int src) {
    visited[src] = true;
    cout << src << " ";

    for (int v : adj[src]) {
        if (!visited[v]) {
            DFS(adj, visited, v);
        }
    }
}

int main() {
    int n = 6;
    vector<vector<int>> adj(n);

    adj[0] = {1, 2};
    adj[1] = {0, 3, 4};
    adj[2] = {0, 4};
    adj[3] = {1, 5};
    adj[4] = {1, 2, 5};
    adj[5] = {3, 4};

    vector<bool> visited(n, false);

    DFS(adj, visited, 0);

    return 0;
}
